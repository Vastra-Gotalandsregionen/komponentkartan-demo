{
  "compileOnSave": false,
  "compilerOptions": {
    "module": "es2020",
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "typeRoots": [
      "node_modules/@types",
      "vgr-komponentkartan.d"
    ],
    "baseUrl": ".",
